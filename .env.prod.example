# Copy to .env.prod and fill in real values; never commit .env.prod.
# Start with: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=karaoke
POSTGRES_USER=karaoke
# Bắt buộc: dùng giá trị ngẫu nhiên dài, ví dụ `openssl rand -base64 24`.
# Compose và backend từ chối giá trị rỗng/placeholder khi chạy profile prod.
POSTGRES_PASSWORD=
DB_POOL_SIZE=10

# --- Public origin ----------------------------------------------------------
# Must be the exact public https origin users open in the browser.
# Wildcards and brackets are rejected on startup.
APP_ALLOWED_ORIGINS=https://karaoke.example.com
# Bắt buộc điền (compose không khởi động nếu thiếu). Chỉ đặt true khi backend nằm
# sau proxy tin cậy có ghi đè X-Forwarded-For (nginx trong compose này làm việc đó);
# nếu không client có thể giả IP để né rate limit và làm sai log audit.
TRUST_FORWARDED_HEADERS=true

# --- Admin bootstrap (only used while the admins table is empty) ------------
# Bắt buộc đổi trước khi deploy: tối thiểu 12 ký tự, không dùng giá trị mẫu.
# Để trống nếu DB đã có admin; lần boot đầu chưa có admin sẽ báo lỗi rõ ràng.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_DAYS=7

# --- Cloudinary (song audio/video storage) ----------------------------------
# Bắt buộc cả 3 biến; thiếu hoặc để giá trị mẫu thì backend không khởi động ở prod.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- HTTP entrypoint --------------------------------------------------------
# Keep loopback; the TLS proxy (Cloudflare Tunnel / Caddy) forwards to this port.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# --- Optional tuning --------------------------------------------------------
MAX_UPLOAD_SIZE=200MB
# Tổng request upload gồm video + giọng gốc; phải >= 2 lần MAX_UPLOAD_SIZE.
# nginx trong frontend đang đặt 420m, đổi giá trị này thì sửa cả frontend/nginx.conf.
MAX_REQUEST_SIZE=420MB
EXTRACT_TIMEOUT_SECONDS=300
JAVA_OPTS=-XX:MaxRAMPercentage=75
