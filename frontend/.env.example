# Leave both empty to call the API/WebSocket on the same origin as the frontend.
# Set these when the backend is deployed on a different host, e.g.
# VITE_API_BASE_URL=https://karaoke-api.example.com
# VITE_WS_ENDPOINT=https://karaoke-api.example.com/ws-karaoke
VITE_API_BASE_URL=
VITE_WS_ENDPOINT=

# Optional JSON array of WebRTC ICE/TURN servers for 4G/Symmetric NAT peers, e.g.
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS_JSON=
